{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup Toolchain",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/setup-windows.ps1"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "scripts/setup-unix.sh"
        ]
      },
